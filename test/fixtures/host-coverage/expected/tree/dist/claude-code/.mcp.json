{
  "mcpServers": {
    "probe": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/server.mjs"
      ]
    },
    "remote": {
      "type": "http",
      "url": "http://127.0.0.1:9/mcp",
      "headers": {
        "Authorization": "Bearer ${TOKEN}"
      }
    }
  }
}
