{
  "mcpServers": {
    "remote": {
      "url": "http://127.0.0.1:9/mcp",
      "headers": { "X-Uapa-Probe": "uapa-header-probe" }
    },
    "plain": { "command": "uapa-mcp-probe", "args": ["--stdio"] },
    "launcher": { "command": "{pluginRoot}/mcp/run.sh" },
    "docs": {
      "command": "node",
      "args": ["{pluginRoot}/mcp/server.mjs"],
      "env": { "UAPA_DATA": "{pluginRoot}/data" }
    }
  }
}
